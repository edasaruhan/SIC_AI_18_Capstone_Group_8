{
  "scope": "Preliminary real-data proxy exploration, not final personalization evaluation",
  "selection": "First 12 CSV filenames in lexicographic order; not a representative sample",
  "participants": 12,
  "valid_window_pairs": 12830,
  "features": [
    "screen_active_seconds",
    "unlock_count",
    "app_switch_count",
    "previous_session_duration_seconds"
  ],
  "window_config": {
    "gap_minutes": 30,
    "max_session_minutes": 120,
    "event_year": 2016
  },
  "cross_validation": {
    "method": "GroupKFold by participant",
    "folds": 3,
    "hyperparameter_search": false
  },
  "proxy": {
    "quantile": 0.9,
    "fit_on": "training users only in each fold",
    "definition": "next-window longest unlocked run >= threshold OR unlock count >= threshold; no night component"
  },
  "hyperparameters": {
    "Logistic Regression": {
      "C": 1.0,
      "max_iter": 1000,
      "random_state": 42,
      "decision_threshold": 0.5,
      "preprocessing": "training median + missing indicators + StandardScaler"
    },
    "Random Forest": {
      "n_estimators": 100,
      "max_depth": 8,
      "min_samples_leaf": 5,
      "class_weight": "balanced",
      "random_state": 42,
      "n_jobs": 1,
      "preprocessing": "training median + missing indicators"
    },
    "Rule": {
      "combination": "any current screen-time/unlock threshold met",
      "score": "match fraction, not a probability"
    }
  },
  "metric_definitions": {
    "pr_auc_ap": "average precision, not trapezoidal PR integration",
    "false_alerts": "FP / unique evaluated participant-UTC-date pairs, including partial days",
    "mean_metrics": "unweighted mean over held-out participant folds",
    "plots": "pooled OOF; proxy thresholds may differ between folds"
  },
